{
  "name": "bergendal",
  "version": "1.0.0",
  "description": "Bergendal monorepo",
  "private": true,
  "scripts": {
    "dev:sveltekit": "pnpm --filter sveltekit dev",
    "dev:sanity": "pnpm --filter sanity dev",
    "dev": "mprocs",
    "build:sveltekit": "pnpm --filter sveltekit build",
    "build:sanity": "pnpm --filter sanity build",
    "deploy:sanity": "pnpm --filter sanity deploy",
    "typegen:sanity": "pnpm --filter sanity typegen",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "mprocs": "^0.7.3",
    "prettier": "^3.7.3",
    "prettier-plugin-svelte": "^3.4.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.24.0"
}
